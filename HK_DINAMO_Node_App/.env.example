# Oracle 19c in Docker. Port 1521 must be published to Windows host.
DB_USER=HK_WEB_APP
DB_PASSWORD=ChangeMe_WebApp_19c!
DB_CONNECT_STRING=127.0.0.1:1521/ORCLPDB1
DB_POOL_MIN=1
DB_POOL_MAX=6

# Generate a long random value and paste it here; used only for first MAIN_ADMIN setup.
SETUP_TOKEN=replace_with_a_random_64_character_secret
SESSION_SECRET=replace_with_another_random_64_character_secret
PORT=3000
NODE_ENV=development
APP_BASE_URL=http://localhost:3000
